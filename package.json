{
  "name": "factory-inventory",
  "version": "1.9.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --publish=never",
    "release": "vite build && electron-builder --publish always",
    "test": "esbuild tests/inventory.test.mjs --bundle --platform=node --format=esm --jsx=automatic --external:react --external:lucide-react --log-level=error --outfile=tests/.inventory.bundle.mjs && node tests/.inventory.bundle.mjs && node tests/main.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.383.0",
    "sql.js": "^1.10.3",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "@fontsource/cairo": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0"
  },
  "build": {
    "appId": "com.factory.inventory",
    "productName": "Factory Inventory",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Factory Inventory",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Factory Inventory"
    },
    "copyright": "Copyright © 2026",
    "artifactName": "Factory-Inventory-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Seifabdin442",
        "repo": "Factory-inventory",
        "releaseType": "release"
      }
    ]
  },
  "description": "Factory Inventory — purchases, production, inventory, sales and client balances for a clothing factory",
  "author": "Factory Inventory"
}
